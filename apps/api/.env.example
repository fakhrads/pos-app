# ============ Database (PostgreSQL 16+, database `db_pos`) ============
# DDL dijalankan via: bun run db:migrate
DATABASE_URL=postgres://pos_app:pos_app_password@localhost:5432/db_pos

# ============ Auth / JWT ============
# Wajib diganti dengan random string panjang (min 32 karakter) di produksi!
JWT_SECRET=change-me-please-use-a-long-random-string-min-32-chars
# Opsional: secret lama (rotasi), dipisah koma
JWT_SECRET_PREVIOUS=
JWT_KID=v1
JWT_ACCESS_TTL=30m
REFRESH_TTL_DAYS=7

# ============ Server ============
PORT=3000
# Origin frontend (mis. https://pos.fakhri.local). "*" = semua origin (dev)
CORS_ORIGIN=*

# ============ Seed admin (dipakai saat `bun run db:migrate` pertama kali) ============
# Akun admin awal TIDAK di-seed via SQL — dibuat aplikasi (Bun.password argon2id)
SEED_ADMIN_EMAIL=admin@fakhripos.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator
